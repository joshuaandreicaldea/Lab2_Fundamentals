   "outputs": [],
   "source": [
    "name = \"CALDEA\" .upper()\n",
    "SEED_NUM = 3\n",
    "red_name = \"\"\n",
    "\n",
    "for char in name:\n",
    "    if char in \"AEIOU\":\n",
    "        red_name += str(SEED_NUM)\n",
    "    else:\n",
    "        red_name += char\n",
    "\n",
    "print(f\"Original Name: {name}\")\n",
    "print(f\"Redacted Name: {red_name}\")"
   ]
  },
